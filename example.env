# Copy this file to `.env` (gitignored — see .gitignore) and edit the values.
#
# DATABASE_URL
#   Override the default SQLite path. Useful for pointing tests or dev at a
#   different DB file. Default: sqlite:///dinner.db (relative to backend/)
#   Example: DATABASE_URL=sqlite:///C:/dev/dinner-test.db
#
# No other config is needed. The app is designed to run with zero setup
# beyond `python app.py` once dependencies are installed.
#
DATABASE_URL=sqlite:///dinner.db
